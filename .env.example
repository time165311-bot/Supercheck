# Server configuration
PORT=3000
NODE_ENV=development
DISABLE_HMR=true

# Firebase configuration (optional fallback when deploying outside AI Studio without firebase-applet-config.json)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=

# Gemini API (Server-side only — never use VITE_GEMINI_API_KEY)
GEMINI_API_KEY=

# API Authentication & HIS/FHIR Integration Security (keep empty in example)
APP_API_SECRET=
FHIR_API_KEY=

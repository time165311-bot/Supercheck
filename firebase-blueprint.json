{
  "entities": {
    "InspectionRecord": {
      "title": "Inspection Record",
      "description": "Historical record of a completed inspection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "who": { "type": "string" },
        "type": { "type": "string", "enum": ["eq", "bag", "cart", "drug"] },
        "title": { "type": "string" },
        "rows": { "type": "array" }
      },
      "required": ["id", "timestamp", "who", "type"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "System audit log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "category": { "type": "string" },
        "timestamp": { "type": "string" },
        "ip": { "type": "string" }
      },
      "required": ["id", "action", "timestamp"]
    },
    "User": {
      "title": "User",
      "description": "Application user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff"] },
        "active": { "type": "boolean" },
        "salt": { "type": "string" },
        "hash": { "type": "string" },
        "must": { "type": "boolean" },
        "created": { "type": "string" },
        "last": { "type": "string" },
        "avatar": { "type": "string" },
        "signature": { "type": "string" },
        "position": { "type": "string" }
      },
      "required": ["id", "username", "name", "role"]
    },
    "GlobalChecks": {
      "title": "Global Checks",
      "description": "Current status of all checklist items",
      "type": "object",
      "properties": {
        "data": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "LastSubmitted": {
      "title": "Last Submitted",
      "description": "Timestamps of last submissions per category/room",
      "type": "object",
      "properties": {
        "data": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "AppSettings": {
      "title": "App Settings",
      "description": "Global application configuration",
      "type": "object",
      "properties": {
        "sheetUrl": { "type": "string" },
        "theme": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/inspection_records/{recordId}": {
      "schema": "InspectionRecord",
      "description": "Collection of inspection history"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Collection of system audit logs"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of application users"
    },
    "/settings/global_checks": {
      "schema": "GlobalChecks",
      "description": "Document storing the current state of all checks"
    },
    "/settings/last_submitted": {
      "schema": "LastSubmitted",
      "description": "Document storing the last submission timestamps"
    },
    "/settings/config": {
      "schema": "AppSettings",
      "description": "Document storing global app configuration"
    }
  }
}

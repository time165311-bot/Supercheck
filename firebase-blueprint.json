{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile linked with Firebase Authentication (no password hashes stored)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "username": { "type": "string", "minLength": 1, "maxLength": 80 },
        "name": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "position": { "type": "string", "maxLength": 150 },
        "signature": { "type": "string", "maxLength": 500000 },
        "active": { "type": "boolean" },
        "must": { "type": "boolean" },
        "created": { "type": "string", "format": "date-time" },
        "last": { "type": "string", "format": "date-time" },
        "avatar": { "type": "string", "maxLength": 500000 },
        "ringColor": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name"]
    },
    "AdminUser": {
      "title": "Admin User",
      "description": "Allowlisted Firebase UID granted admin privileges",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "grantedAt": { "type": "string", "format": "date-time" },
        "grantedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["uid"]
    },
    "EquipmentItem": {
      "title": "Equipment Item",
      "description": "A single piece of equipment in a bag, cart, or room",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 300 },
        "code": { "type": "string", "maxLength": 150 },
        "sap": { "type": "string", "maxLength": 150 },
        "spec": { "type": "string", "maxLength": 1000 },
        "source": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 100 },
        "qty": { "type": "string", "maxLength": 100 },
        "tax": { "type": "string", "maxLength": 50 },
        "price": { "type": "string", "maxLength": 50 },
        "location": { "type": "string", "maxLength": 200 },
        "img": { "type": "string", "maxLength": 500000 },
        "no": { "type": "string", "maxLength": 50 },
        "exp": { "type": "string", "maxLength": 1000 },
        "note": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 200 },
        "groupName": { "type": "string", "maxLength": 200 },
        "roomId": { "type": "string", "maxLength": 100 },
        "barcode": { "type": "string", "maxLength": 150 },
        "serialNumber": { "type": "string", "maxLength": 150 },
        "subExps": { "type": "array" },
        "subItemQuantities": { "type": "array" },
        "checkType": { "type": "string", "enum": ["single", "sub_items"] },
        "subItems": { "type": "array" },
        "unitText": { "type": "string", "maxLength": 100 },
        "initialQtyText": { "type": "string", "maxLength": 100 },
        "channelId": { "type": "string", "maxLength": 128 },
        "wardId": { "type": "string", "maxLength": 48 },
        "orderNumber": { "type": "string", "maxLength": 50 },
        "assetCode": { "type": "string", "maxLength": 150 },
        "sapCode": { "type": "string", "maxLength": 150 },
        "brandModel": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "maxLength": 50 },
        "isMarked": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "DrugItem": {
      "title": "Drug Item",
      "description": "A medication or fluid in the inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "category": { "type": "string", "enum": ["monthly", "quarterly", "adhoc"] },
        "name": { "type": "string", "maxLength": 300 },
        "remaining": { "type": "number" },
        "totalQty": { "type": "number" },
        "receivedDate": { "type": "string", "maxLength": 100 },
        "receivedQty": { "type": "number" },
        "minStock": { "type": "number" },
        "batchRequest": { "type": "string", "maxLength": 150 },
        "unit": { "type": "string", "maxLength": 100 },
        "expDate": { "type": "string", "maxLength": 1000 },
        "exp": { "type": "string", "maxLength": 1000 },
        "lotNumber": { "type": "string", "maxLength": 150 },
        "lots": { "type": "array" },
        "batches": { "type": "array" },
        "tmtCode": { "type": "string", "maxLength": 100 },
        "hospitalDrugCode": { "type": "string", "maxLength": 100 },
        "spec": { "type": "string", "maxLength": 500 },
        "note": { "type": "string", "maxLength": 1000 },
        "img": { "type": "string", "maxLength": 500000 },
        "barcode": { "type": "string", "maxLength": 150 },
        "channelId": { "type": "string", "maxLength": 128 },
        "wardId": { "type": "string", "maxLength": 48 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category"]
    },
    "InspectionRecord": {
      "title": "Inspection Record",
      "description": "Historical record of an inspection round",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "timestamp": { "type": "string", "format": "date-time" },
        "date": { "type": "string", "maxLength": 100 },
        "time": { "type": "string", "maxLength": 100 },
        "who": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["eq", "bag", "cart", "ambulance", "drug"] },
        "title": { "type": "string", "maxLength": 300 },
        "rows": { "type": "array" },
        "weekDates": { "type": "object" },
        "channelId": { "type": "string", "maxLength": 128 },
        "wardId": { "type": "string", "maxLength": 48 }
      },
      "required": ["id", "timestamp", "date", "who", "type"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Application settings, channel list, and persistent clear-state flags",
      "type": "object",
      "properties": {
        "sheetUrl": { "type": "string", "maxLength": 1000 },
        "apiUrl": { "type": "string", "maxLength": 1000 },
        "theme": { "type": "string", "maxLength": 20 },
        "globalChecks": { "type": "object" },
        "lastSubmitted": { "type": "object" },
        "drugsCleared": { "type": "boolean" },
        "equipmentCleared": { "type": "boolean" },
        "bagCleared": { "type": "boolean" },
        "cartCleared": { "type": "boolean" },
        "channelsInitialized": { "type": "boolean" },
        "channels": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "WardChannelData": {
      "title": "Ward Channel Data",
      "description": "Isolated channel lists, check states, and week dates per ward channel",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lists": { "type": "object" },
        "globalChecks": { "type": "object" },
        "emergencyWeekDates": { "type": "object" },
        "drugsCleared": { "type": "boolean" },
        "equipmentCleared": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id"]
    },
    "WardWorkspace": {
      "title": "Shared Ward Workspace",
      "description": "Shared real-time workspace keyed by Ward Code (default ANES-MASTER) with lists, checks, tombstones, and optional hashed 4-digit edit PIN",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "minLength": 2, "maxLength": 48 },
        "name": { "type": "string", "maxLength": 150 },
        "lists": { "type": "object" },
        "globalChecks": { "type": "object" },
        "emergencyWeekDates": { "type": "object" },
        "deletedItemIds": { "type": "array" },
        "drugsCleared": { "type": "boolean" },
        "equipmentCleared": { "type": "boolean" },
        "bagCleared": { "type": "boolean" },
        "cartCleared": { "type": "boolean" },
        "ambulanceCleared": { "type": "boolean" },
        "equipmentSeeded": { "type": "boolean" },
        "drugsSeeded": { "type": "boolean" },
        "migratedFromLegacy": { "type": "boolean" },
        "pinEnabled": { "type": "boolean" },
        "pinHash": { "type": "string", "maxLength": 128 },
        "pinSalt": { "type": "string", "maxLength": 64 },
        "sheetUrl": { "type": "string", "maxLength": 1000 },
        "apiUrl": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id"]
    },
    "RestockRequisition": {
      "title": "Restock Requisition",
      "description": "Medication or emergency equipment restock requisition record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "channelId": { "type": "string", "maxLength": 128 },
        "wardId": { "type": "string", "maxLength": 48 },
        "targetCategory": { "type": "string", "maxLength": 100 },
        "requestedBy": { "type": "string", "maxLength": 150 },
        "requestedById": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["draft", "pending", "approved", "rejected", "received"] },
        "notes": { "type": "string", "maxLength": 1000 },
        "items": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "approvedBy": { "type": "string", "maxLength": 150 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "rejectedReason": { "type": "string", "maxLength": 500 },
        "receivedBy": { "type": "string", "maxLength": 150 },
        "receivedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "createdAt", "items"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Shared Ward activity and audit trail record with diff metadata and optional admin restore tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "timestamp": { "type": "string", "format": "date-time" },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 150 },
        "operatorName": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 50 },
        "action": { "type": "string", "maxLength": 100 },
        "targetCollection": { "type": "string", "maxLength": 100 },
        "targetId": { "type": "string", "maxLength": 128 },
        "wardId": { "type": "string", "maxLength": 48 },
        "itemName": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "maxLength": 150 },
        "oldValue": { "type": "string", "maxLength": 2000 },
        "newValue": { "type": "string", "maxLength": 2000 },
        "trashId": { "type": "string", "maxLength": 128 },
        "restorablePayload": { "type": "object" },
        "restoredAt": { "type": "string", "format": "date-time" },
        "restoredBy": { "type": "string", "maxLength": 150 },
        "details": { "type": "object" },
        "ipAddress": { "type": "string", "maxLength": 100 }
      },
      "required": ["timestamp", "userId", "action", "targetCollection"]
    },
    "WardPermissionLocks": {
      "title": "Ward Permission Locks",
      "description": "Owner/Admin-managed permission locks scoped to a ward workspace",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "wardId": { "type": "string", "maxLength": 48 },
        "lockStaffDeleteItems": { "type": "boolean" },
        "lockStaffEditStructure": { "type": "boolean" },
        "lockGoogleSheetsExport": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "maxLength": 150 }
      },
      "required": ["id", "wardId", "lockStaffDeleteItems", "lockStaffEditStructure", "lockGoogleSheetsExport"]
    },
    "TrashItem": {
      "title": "Trash Item Snapshot",
      "description": "Full restorable snapshot of deleted drug, equipment, or checklist item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "wardId": { "type": "string", "maxLength": 48 },
        "targetType": { "type": "string", "enum": ["drug", "bag", "cart", "ambulance", "room"] },
        "category": { "type": "string", "maxLength": 150 },
        "groupOrRoomId": { "type": "string", "maxLength": 200 },
        "itemName": { "type": "string", "maxLength": 300 },
        "payload": { "type": "object" },
        "tombstoneTokens": { "type": "array" },
        "deletedBy": { "type": "string", "maxLength": 150 },
        "deletedAt": { "type": "string", "format": "date-time" },
        "restoredAt": { "type": "string", "format": "date-time" },
        "restoredBy": { "type": "string", "maxLength": 150 }
      },
      "required": ["id", "wardId", "targetType", "itemName", "payload", "deletedBy", "deletedAt"]
    },
    "WardAiMemory": {
      "title": "Ward AI Memory",
      "description": "Ward-specific custom glossary, equipment nicknames, shorthand aliases, and AI instructions synced across sessions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "wardId": { "type": "string", "maxLength": 48 },
        "triggerPhrase": { "type": "string", "maxLength": 200 },
        "meaning": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 100 },
        "ruleType": { "type": "string", "maxLength": 50 },
        "createdBy": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "wardId", "triggerPhrase", "meaning", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Admin role allowlist keyed by Firebase Auth UID"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Inspector profile preferences (owned by Firebase Auth UID or managed by Admin)"
    },
    "/wards/{wardId}": {
      "schema": "WardWorkspace",
      "description": "Shared Ward Workspace document (default ANES-MASTER) synced in real time across devices"
    },
    "/wards/{wardId}/equipment/{itemId}": {
      "schema": "EquipmentItem",
      "description": "Shared Ward equipment catalog"
    },
    "/wards/{wardId}/drugs/{drugId}": {
      "schema": "DrugItem",
      "description": "Shared Ward drug inventory"
    },
    "/wards/{wardId}/inspection_records/{recordId}": {
      "schema": "InspectionRecord",
      "description": "Shared Ward inspection history"
    },
    "/wards/{wardId}/restock_requisitions/{reqId}": {
      "schema": "RestockRequisition",
      "description": "Shared Ward restock requisitions"
    },
    "/wards/{wardId}/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Shared Ward activity audit trail with admin restore metadata"
    },
    "/wards/{wardId}/admin_config/{configId}": {
      "schema": "WardPermissionLocks",
      "description": "Shared Ward admin permission lock configuration"
    },
    "/wards/{wardId}/trash/{trashId}": {
      "schema": "TrashItem",
      "description": "Shared Ward deleted-item snapshots for admin one-click restore"
    },
    "/wards/{wardId}/ai_memory/{memoryId}": {
      "schema": "WardAiMemory",
      "description": "Shared Ward custom AI glossary, nicknames, and persistent rules"
    },
    "/equipment/{itemId}": {
      "schema": "EquipmentItem",
      "description": "Legacy equipment items catalog (Master)"
    },
    "/drugs/{drugId}": {
      "schema": "DrugItem",
      "description": "Legacy drug inventory (Master)"
    },
    "/inspection_records/{recordId}": {
      "schema": "InspectionRecord",
      "description": "Legacy historical inspection results"
    },
    "/settings/{docId}": {
      "schema": "Settings",
      "description": "Global application configuration, channels, and app clear state flags"
    },
    "/restock_requisitions/{reqId}": {
      "schema": "RestockRequisition",
      "description": "Legacy restock requisitions"
    },
    "/channels/{channelId}": {
      "schema": "WardChannelData",
      "description": "Legacy per-ward isolated inspection state and lists"
    },
    "/channels/{channelId}/equipment/{itemId}": {
      "schema": "EquipmentItem",
      "description": "Legacy per-ward isolated equipment catalog"
    },
    "/channels/{channelId}/drugs/{drugId}": {
      "schema": "DrugItem",
      "description": "Legacy per-ward isolated drug inventory"
    },
    "/channels/{channelId}/inspection_records/{recordId}": {
      "schema": "InspectionRecord",
      "description": "Legacy per-ward isolated inspection history"
    },
    "/channels/{channelId}/restock_requisitions/{reqId}": {
      "schema": "RestockRequisition",
      "description": "Legacy per-ward isolated restock requisitions"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Append-only immutable audit trail and activity log"
    }
  }
}

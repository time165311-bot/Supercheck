{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and authentication data",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 3, "maxLength": 50 },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "position": { "type": "string", "maxLength": 100 },
        "signature": { "type": "string" },
        "active": { "type": "boolean" },
        "salt": { "type": "string" },
        "hash": { "type": "string" },
        "must": { "type": "boolean" },
        "created": { "type": "string", "format": "date-time" },
        "last": { "type": "string", "format": "date-time" },
        "avatar": { "type": "string" },
        "ringColor": { "type": "string" }
      },
      "required": ["id", "username", "name", "role", "active", "created"]
    },
    "EquipmentItem": {
      "title": "Equipment Item",
      "description": "A single piece of equipment in a bag, cart, or room",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 200 },
        "code": { "type": "string", "maxLength": 100 },
        "sap": { "type": "string", "maxLength": 100 },
        "spec": { "type": "string", "maxLength": 500 },
        "source": { "type": "string", "maxLength": 100 },
        "date": { "type": "string" },
        "qty": { "type": "string", "maxLength": 50 },
        "tax": { "type": "string" },
        "price": { "type": "string" },
        "location": { "type": "string", "maxLength": 100 },
        "img": { "type": "string" },
        "no": { "type": "string", "maxLength": 20 },
        "exp": { "type": "string", "maxLength": 1000 },
        "note": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name"]
    },
    "DrugItem": {
      "title": "Drug Item",
      "description": "A medication or fluid in the inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "category": { "type": "string", "enum": ["monthly", "quarterly", "adhoc"] },
        "name": { "type": "string", "maxLength": 200 },
        "remaining": { "type": "number" },
        "receivedDate": { "type": "string" },
        "receivedQty": { "type": "number" },
        "minStock": { "type": "number" },
        "batchRequest": { "type": "string", "maxLength": 100 },
        "unit": { "type": "string", "maxLength": 50 },
        "expDate": { "type": "string", "maxLength": 1000 },
        "note": { "type": "string", "maxLength": 500 },
        "img": { "type": "string" },
        "barcode": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "category"]
    },
    "InspectionRecord": {
      "title": "Inspection Record",
      "description": "Historical record of an inspection round",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "timestamp": { "type": "string", "format": "date-time" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "who": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["eq", "bag", "cart", "drug"] },
        "title": { "type": "string", "maxLength": 200 },
        "rows": { "type": "array" },
        "weekDates": { "type": "object" }
      },
      "required": ["id", "timestamp", "date", "who", "type"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Application settings and global state",
      "type": "object",
      "properties": {
        "sheetUrl": { "type": "string" },
        "apiUrl": { "type": "string" },
        "theme": { "type": "string" },
        "globalChecks": { "type": "object" },
        "lastSubmitted": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered users"
    },
    "/equipment/{itemId}": {
      "schema": "EquipmentItem",
      "description": "Equipment items catalog"
    },
    "/drugs/{drugId}": {
      "schema": "DrugItem",
      "description": "Drug inventory"
    },
    "/inspection_records/{recordId}": {
      "schema": "InspectionRecord",
      "description": "Historical inspection results"
    },
    "/settings/config": {
      "schema": "Settings",
      "description": "Global application configuration"
    }
  }
}


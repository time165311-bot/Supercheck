rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Catch-all: default deny all unhandled collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable authentication, authorization & schema validation primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'time165311@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidWardId(wardId) {
      return wardId is string && wardId.size() >= 2 && wardId.size() <= 48 && wardId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function wardExists(wardId) {
      return exists(/databases/$(database)/documents/wards/$(wardId));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptionalNumber(data, key) {
      return !(key in data) || data[key] == null || (data[key] is number);
    }

    function isOptionalBool(data, key) {
      return !(key in data) || data[key] == null || (data[key] is bool);
    }

    function isOptionalList(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is list && data[key].size() <= maxLen);
    }

    function isOptionalMap(data, key) {
      return !(key in data) || data[key] == null || (data[key] is map);
    }

    // Enforce bounded base64/URL image sizes (< 500,000 chars) to protect document quota
    function isValidImageSize(data) {
      return isOptionalString(data, 'img', 500000) &&
        isOptionalString(data, 'avatar', 500000) &&
        isOptionalString(data, 'signature', 500000);
    }

    function isValidAdminDoc(data) {
      return data.keys().hasAll(['uid']) &&
        data.keys().hasOnly(['uid', 'email', 'grantedAt', 'grantedBy']) &&
        isValidId(data.uid) &&
        isOptionalString(data, 'email', 200) &&
        isOptionalString(data, 'grantedAt', 100) &&
        isOptionalString(data, 'grantedBy', 128);
    }

    function isValidEquipment(data) {
      return data.keys().hasAll(['id', 'name']) &&
        data.keys().hasOnly([
          'id', 'name', 'code', 'sap', 'spec', 'source', 'date', 'qty', 'tax', 'price',
          'location', 'img', 'no', 'exp', 'note', 'type', 'category', 'groupName', 'roomId',
          'barcode', 'serialNumber', 'subExps', 'subItemQuantities', 'checkType',
          'subItems', 'unitText', 'initialQtyText', 'channelId', 'wardId',
          'orderNumber', 'assetCode', 'sapCode', 'brandModel', 'status', 'isMarked', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 300 &&
        isOptionalString(data, 'code', 150) &&
        isOptionalString(data, 'sap', 150) &&
        isOptionalString(data, 'spec', 1000) &&
        isOptionalString(data, 'source', 200) &&
        isOptionalString(data, 'date', 100) &&
        isOptionalString(data, 'qty', 100) &&
        isOptionalString(data, 'tax', 50) &&
        isOptionalString(data, 'price', 50) &&
        isOptionalString(data, 'location', 200) &&
        isOptionalString(data, 'no', 50) &&
        isOptionalString(data, 'exp', 1000) &&
        isOptionalString(data, 'note', 1000) &&
        isOptionalString(data, 'type', 50) &&
        isOptionalString(data, 'category', 200) &&
        isOptionalString(data, 'groupName', 200) &&
        isOptionalString(data, 'roomId', 100) &&
        isOptionalString(data, 'barcode', 150) &&
        isOptionalString(data, 'serialNumber', 150) &&
        isOptionalString(data, 'checkType', 30) &&
        isOptionalString(data, 'unitText', 100) &&
        isOptionalString(data, 'initialQtyText', 100) &&
        isOptionalString(data, 'channelId', 128) &&
        isOptionalString(data, 'wardId', 48) &&
        isOptionalString(data, 'orderNumber', 50) &&
        isOptionalString(data, 'assetCode', 150) &&
        isOptionalString(data, 'sapCode', 150) &&
        isOptionalString(data, 'brandModel', 500) &&
        isOptionalString(data, 'status', 50) &&
        isOptionalString(data, 'updatedAt', 100) &&
        isOptionalBool(data, 'isMarked') &&
        isOptionalList(data, 'subItems', 100) &&
        isOptionalList(data, 'subItemQuantities', 100) &&
        isOptionalList(data, 'subExps', 100) &&
        isValidImageSize(data);
    }

    function isValidDrug(data) {
      return data.keys().hasAll(['id', 'name', 'category']) &&
        data.keys().hasOnly([
          'id', 'category', 'name', 'remaining', 'totalQty', 'receivedDate',
          'receivedQty', 'minStock', 'batchRequest', 'unit', 'expDate', 'exp',
          'lotNumber', 'lots', 'batches', 'tmtCode', 'hospitalDrugCode',
          'spec', 'note', 'img', 'barcode', 'channelId', 'wardId', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 300 &&
        data.category is string && data.category in ['monthly', 'quarterly', 'adhoc'] &&
        isOptionalNumber(data, 'remaining') &&
        isOptionalNumber(data, 'totalQty') &&
        isOptionalString(data, 'receivedDate', 100) &&
        isOptionalNumber(data, 'receivedQty') &&
        isOptionalNumber(data, 'minStock') &&
        isOptionalString(data, 'batchRequest', 150) &&
        isOptionalString(data, 'unit', 100) &&
        isOptionalString(data, 'expDate', 1000) &&
        isOptionalString(data, 'exp', 1000) &&
        isOptionalString(data, 'lotNumber', 150) &&
        isOptionalString(data, 'tmtCode', 100) &&
        isOptionalString(data, 'hospitalDrugCode', 100) &&
        isOptionalString(data, 'spec', 500) &&
        isOptionalString(data, 'note', 1000) &&
        isOptionalString(data, 'barcode', 150) &&
        isOptionalString(data, 'channelId', 128) &&
        isOptionalString(data, 'wardId', 48) &&
        isOptionalString(data, 'updatedAt', 100) &&
        isOptionalList(data, 'lots', 100) &&
        isOptionalList(data, 'batches', 100) &&
        isValidImageSize(data);
    }

    function isValidInspectionRecord(data) {
      return data.keys().hasAll(['id', 'timestamp', 'date', 'who', 'type']) &&
        data.keys().hasOnly(['id', 'timestamp', 'date', 'time', 'who', 'type', 'title', 'rows', 'weekDates', 'channelId', 'wardId']) &&
        isValidId(data.id) &&
        data.timestamp is string && data.timestamp.size() <= 100 &&
        data.date is string && data.date.size() <= 100 &&
        data.who is string && data.who.size() <= 200 &&
        data.type is string && data.type in ['eq', 'bag', 'cart', 'ambulance', 'drug'] &&
        isOptionalString(data, 'time', 100) &&
        isOptionalString(data, 'title', 300) &&
        isOptionalString(data, 'channelId', 128) &&
        isOptionalString(data, 'wardId', 48) &&
        isOptionalMap(data, 'weekDates') &&
        isOptionalList(data, 'rows', 500);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'name']) &&
        data.keys().hasOnly([
          'id', 'uid', 'email', 'username', 'name', 'role', 'position', 'signature',
          'active', 'must', 'created', 'last', 'avatar', 'ringColor'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
        (!('role' in data) || data.role in ['admin', 'user']) &&
        isOptionalString(data, 'uid', 128) &&
        isOptionalString(data, 'email', 200) &&
        isOptionalString(data, 'username', 80) &&
        isOptionalString(data, 'position', 150) &&
        isOptionalString(data, 'created', 100) &&
        isOptionalString(data, 'last', 100) &&
        isOptionalString(data, 'ringColor', 50) &&
        isOptionalBool(data, 'active') &&
        isOptionalBool(data, 'must') &&
        isValidImageSize(data);
    }

    function isValidSettings(data) {
      return data.keys().hasOnly([
          'sheetUrl', 'apiUrl', 'theme', 'globalChecks', 'lastSubmitted',
          'drugsCleared', 'equipmentCleared', 'bagCleared', 'cartCleared',
          'channelsInitialized', 'channels', 'updatedAt'
        ]) &&
        isOptionalString(data, 'sheetUrl', 1000) &&
        isOptionalString(data, 'apiUrl', 1000) &&
        isOptionalString(data, 'theme', 20) &&
        isOptionalString(data, 'updatedAt', 100) &&
        isOptionalBool(data, 'drugsCleared') &&
        isOptionalBool(data, 'equipmentCleared') &&
        isOptionalBool(data, 'bagCleared') &&
        isOptionalBool(data, 'cartCleared') &&
        isOptionalBool(data, 'channelsInitialized') &&
        isOptionalList(data, 'channels', 100);
    }

    function isValidChannelData(data) {
      return data.keys().hasAll(['id']) &&
        data.keys().hasOnly([
          'id', 'lists', 'globalChecks', 'emergencyWeekDates',
          'deletedItemIds', 'drugsCleared', 'equipmentCleared', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isOptionalList(data, 'deletedItemIds', 500) &&
        isOptionalBool(data, 'drugsCleared') &&
        isOptionalBool(data, 'equipmentCleared') &&
        isOptionalString(data, 'updatedAt', 100);
    }

    function isValidWardDoc(data) {
      return data.keys().hasAll(['id']) &&
        data.keys().hasOnly([
          'id', 'name', 'lists', 'globalChecks', 'emergencyWeekDates',
          'deletedItemIds', 'drugsCleared', 'equipmentCleared',
          'bagCleared', 'cartCleared', 'ambulanceCleared',
          'equipmentSeeded', 'drugsSeeded', 'migratedFromLegacy',
          'pinEnabled', 'pinHash', 'pinSalt', 'sheetUrl', 'apiUrl', 'updatedAt'
        ]) &&
        isValidWardId(data.id) &&
        isOptionalString(data, 'name', 150) &&
        isOptionalMap(data, 'lists') &&
        isOptionalMap(data, 'globalChecks') &&
        isOptionalMap(data, 'emergencyWeekDates') &&
        isOptionalList(data, 'deletedItemIds', 500) &&
        isOptionalBool(data, 'drugsCleared') &&
        isOptionalBool(data, 'equipmentCleared') &&
        isOptionalBool(data, 'bagCleared') &&
        isOptionalBool(data, 'cartCleared') &&
        isOptionalBool(data, 'ambulanceCleared') &&
        isOptionalBool(data, 'equipmentSeeded') &&
        isOptionalBool(data, 'drugsSeeded') &&
        isOptionalBool(data, 'migratedFromLegacy') &&
        isOptionalBool(data, 'pinEnabled') &&
        isOptionalString(data, 'pinHash', 128) &&
        isOptionalString(data, 'pinSalt', 64) &&
        isOptionalString(data, 'sheetUrl', 1000) &&
        isOptionalString(data, 'apiUrl', 1000) &&
        isOptionalString(data, 'updatedAt', 100);
    }

    function isValidRestockRequisition(data) {
      return data.keys().hasAll(['id', 'createdAt', 'items']) &&
        data.keys().hasOnly([
          'id', 'channelId', 'wardId', 'targetCategory', 'requestedBy', 'requestedById',
          'status', 'notes', 'items', 'createdAt', 'updatedAt',
          'approvedBy', 'approvedAt', 'rejectedReason', 'receivedBy', 'receivedAt'
        ]) &&
        isValidId(data.id) &&
        data.createdAt is string && data.createdAt.size() <= 100 &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 200 &&
        isOptionalString(data, 'channelId', 128) &&
        isOptionalString(data, 'wardId', 48) &&
        isOptionalString(data, 'targetCategory', 100) &&
        isOptionalString(data, 'requestedBy', 150) &&
        isOptionalString(data, 'requestedById', 128) &&
        isOptionalString(data, 'status', 50) &&
        (!('status' in data) || data.status in ['draft', 'pending', 'approved', 'rejected', 'received']) &&
        isOptionalString(data, 'notes', 1000) &&
        isOptionalString(data, 'updatedAt', 100) &&
        isOptionalString(data, 'approvedBy', 150) &&
        isOptionalString(data, 'approvedAt', 100) &&
        isOptionalString(data, 'rejectedReason', 500) &&
        isOptionalString(data, 'receivedBy', 150) &&
        isOptionalString(data, 'receivedAt', 100);
    }

    function matchesChannelScope(data, channelId) {
      return !('channelId' in data) || data.channelId == null || data.channelId == channelId;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['timestamp', 'userId', 'action', 'targetCollection']) &&
        data.keys().hasOnly([
          'id', 'timestamp', 'userId', 'userName', 'operatorName', 'role', 'action',
          'targetCollection', 'targetId', 'wardId', 'itemName', 'category',
          'oldValue', 'newValue', 'trashId', 'restorablePayload',
          'restoredAt', 'restoredBy', 'details', 'ipAddress'
        ]) &&
        data.timestamp is string && data.timestamp.size() <= 100 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.action is string && data.action.size() <= 100 &&
        data.targetCollection is string && data.targetCollection.size() <= 100 &&
        isOptionalString(data, 'id', 128) &&
        isOptionalString(data, 'userName', 150) &&
        isOptionalString(data, 'operatorName', 150) &&
        isOptionalString(data, 'role', 50) &&
        isOptionalString(data, 'targetId', 128) &&
        isOptionalString(data, 'wardId', 48) &&
        isOptionalString(data, 'itemName', 300) &&
        isOptionalString(data, 'category', 150) &&
        isOptionalString(data, 'oldValue', 2000) &&
        isOptionalString(data, 'newValue', 2000) &&
        isOptionalString(data, 'trashId', 128) &&
        isOptionalMap(data, 'restorablePayload') &&
        isOptionalString(data, 'restoredAt', 100) &&
        isOptionalString(data, 'restoredBy', 150) &&
        isOptionalMap(data, 'details') &&
        isOptionalString(data, 'ipAddress', 100);
    }

    function isValidWardAdminConfig(data) {
      return data.keys().hasAll([
          'id', 'wardId', 'lockStaffDeleteItems', 'lockStaffEditStructure', 'lockGoogleSheetsExport'
        ]) &&
        data.keys().hasOnly([
          'id', 'wardId', 'lockStaffDeleteItems', 'lockStaffEditStructure',
          'lockGoogleSheetsExport', 'updatedAt', 'updatedBy'
        ]) &&
        isValidId(data.id) &&
        isValidWardId(data.wardId) &&
        data.lockStaffDeleteItems is bool &&
        data.lockStaffEditStructure is bool &&
        data.lockGoogleSheetsExport is bool &&
        isOptionalString(data, 'updatedAt', 100) &&
        isOptionalString(data, 'updatedBy', 150);
    }

    function isValidTrashItem(data) {
      return data.keys().hasAll([
          'id', 'wardId', 'targetType', 'itemName', 'payload', 'deletedBy', 'deletedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'wardId', 'targetType', 'category', 'groupOrRoomId', 'itemName',
          'payload', 'tombstoneTokens', 'deletedBy', 'deletedAt', 'restoredAt', 'restoredBy'
        ]) &&
        isValidId(data.id) &&
        isValidWardId(data.wardId) &&
        data.targetType is string && data.targetType in ['drug', 'bag', 'cart', 'ambulance', 'room'] &&
        isOptionalString(data, 'category', 150) &&
        isOptionalString(data, 'groupOrRoomId', 200) &&
        data.itemName is string && data.itemName.size() >= 1 && data.itemName.size() <= 300 &&
        data.payload is map &&
        isOptionalList(data, 'tombstoneTokens', 20) &&
        data.deletedBy is string && data.deletedBy.size() <= 150 &&
        data.deletedAt is string && data.deletedAt.size() <= 100 &&
        isOptionalString(data, 'restoredAt', 100) &&
        isOptionalString(data, 'restoredBy', 150);
    }

    function isValidWardAiMemory(data) {
      return data.keys().hasAll([
          'id', 'wardId', 'triggerPhrase', 'meaning', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'wardId', 'triggerPhrase', 'meaning', 'category',
          'ruleType', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidWardId(data.wardId) &&
        data.triggerPhrase is string && data.triggerPhrase.size() >= 1 && data.triggerPhrase.size() <= 200 &&
        data.meaning is string && data.meaning.size() >= 1 && data.meaning.size() <= 500 &&
        isOptionalString(data, 'category', 100) &&
        isOptionalString(data, 'ruleType', 50) &&
        isOptionalString(data, 'createdBy', 150) &&
        data.createdAt is string && data.createdAt.size() <= 100 &&
        data.updatedAt is string && data.updatedAt.size() <= 100;
    }

    // Shared Ward Workspace (Default ANES-MASTER): real-time cross-device sync without login friction
    match /wards/{wardId} {
      allow get: if isValidWardId(wardId);
      allow list: if false;
      allow create: if isValidWardId(wardId) && isValidWardDoc(incoming()) && incoming().id == wardId;
      allow update: if isValidWardId(wardId) && isValidWardDoc(incoming()) &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'lists', 'globalChecks', 'emergencyWeekDates',
          'deletedItemIds', 'drugsCleared', 'equipmentCleared',
          'bagCleared', 'cartCleared', 'ambulanceCleared',
          'equipmentSeeded', 'drugsSeeded', 'migratedFromLegacy',
          'pinEnabled', 'pinHash', 'pinSalt', 'sheetUrl', 'apiUrl', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidWardId(wardId) && wardId != 'ANES-MASTER';

      match /equipment/{itemId} {
        allow get: if isValidWardId(wardId) && isValidId(itemId) && wardExists(wardId);
        allow list: if isValidWardId(wardId) && existing().wardId == wardId;
        allow create: if isValidWardId(wardId) && isValidId(itemId) &&
          isValidEquipment(incoming()) && incoming().wardId == wardId && wardExists(wardId);
        allow update: if isValidWardId(wardId) && isValidId(itemId) &&
          isValidEquipment(incoming()) &&
          incoming().id == existing().id &&
          incoming().wardId == wardId &&
          wardExists(wardId);
        allow delete: if isValidWardId(wardId) && isValidId(itemId) && wardExists(wardId);
      }

      match /drugs/{drugId} {
        allow get: if isValidWardId(wardId) && isValidId(drugId) && wardExists(wardId);
        allow list: if isValidWardId(wardId) && existing().wardId == wardId;
        allow create: if isValidWardId(wardId) && isValidId(drugId) &&
          isValidDrug(incoming()) && incoming().wardId == wardId && wardExists(wardId);
        allow update: if isValidWardId(wardId) && isValidId(drugId) &&
          isValidDrug(incoming()) &&
          incoming().id == existing().id &&
          incoming().wardId == wardId &&
          wardExists(wardId);
        allow delete: if isValidWardId(wardId) && isValidId(drugId) && wardExists(wardId);
      }

      match /inspection_records/{recordId} {
        allow get: if isValidWardId(wardId) && isValidId(recordId) && wardExists(wardId);
        allow list: if isValidWardId(wardId) && existing().wardId == wardId;
        allow create: if isValidWardId(wardId) && isValidId(recordId) &&
          isValidInspectionRecord(incoming()) && incoming().wardId == wardId && wardExists(wardId);
        allow update: if isValidWardId(wardId) && isValidId(recordId) &&
          isValidInspectionRecord(incoming()) &&
          incoming().id == existing().id &&
          incoming().wardId == wardId &&
          wardExists(wardId);
        allow delete: if isValidWardId(wardId) && isValidId(recordId) && wardExists(wardId);
      }

      match /restock_requisitions/{reqId} {
        allow get: if isValidWardId(wardId) && isValidId(reqId) && wardExists(wardId);
        allow list: if isValidWardId(wardId) && existing().wardId == wardId;
        allow create: if isValidWardId(wardId) && isValidId(reqId) &&
          isValidRestockRequisition(incoming()) && incoming().wardId == wardId && wardExists(wardId) &&
          (!('status' in incoming()) || incoming().status in ['draft', 'pending']);
        allow update: if isValidWardId(wardId) && isValidId(reqId) &&
          isValidRestockRequisition(incoming()) &&
          incoming().id == existing().id &&
          incoming().wardId == wardId &&
          wardExists(wardId) &&
          existing().status != 'received';
        allow delete: if isValidWardId(wardId) && isValidId(reqId) &&
          wardExists(wardId) && existing().status != 'received';
      }

      match /audit_logs/{logId} {
        allow get: if isValidWardId(wardId) && isValidId(logId) && wardExists(wardId);
        allow list: if isValidWardId(wardId) && existing().wardId == wardId;
        allow create: if isValidWardId(wardId) && isValidId(logId) &&
          isValidAuditLog(incoming()) && incoming().wardId == wardId && wardExists(wardId);
        allow update: if isAdmin() && isValidWardId(wardId) && isValidId(logId) &&
          isValidAuditLog(incoming()) && incoming().wardId == wardId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['restoredAt', 'restoredBy']) &&
          wardExists(wardId);
        allow delete: if isAdmin() && isValidWardId(wardId) && isValidId(logId) && wardExists(wardId);
      }

      match /admin_config/{configId} {
        allow get: if isValidWardId(wardId) && isValidId(configId) && wardExists(wardId);
        allow list: if isValidWardId(wardId) && existing().wardId == wardId;
        allow create: if isAdmin() && isValidWardId(wardId) && isValidId(configId) &&
          isValidWardAdminConfig(incoming()) && incoming().wardId == wardId && wardExists(wardId);
        allow update: if isAdmin() && isValidWardId(wardId) && isValidId(configId) &&
          isValidWardAdminConfig(incoming()) &&
          incoming().id == existing().id &&
          incoming().wardId == wardId &&
          wardExists(wardId);
        allow delete: if isAdmin() && isValidWardId(wardId) && isValidId(configId) && wardExists(wardId);
      }

      match /trash/{trashId} {
        allow get: if isValidWardId(wardId) && isValidId(trashId) && wardExists(wardId);
        allow list: if isValidWardId(wardId) && existing().wardId == wardId;
        allow create: if isValidWardId(wardId) && isValidId(trashId) &&
          isValidTrashItem(incoming()) && incoming().wardId == wardId && wardExists(wardId);
        allow update: if isAdmin() && isValidWardId(wardId) && isValidId(trashId) &&
          isValidTrashItem(incoming()) &&
          incoming().id == existing().id &&
          incoming().wardId == wardId &&
          wardExists(wardId);
        allow delete: if isAdmin() && isValidWardId(wardId) && isValidId(trashId) && wardExists(wardId);
      }

      match /ai_memory/{memoryId} {
        allow get: if isValidWardId(wardId) && isValidId(memoryId) && wardExists(wardId);
        allow list: if isValidWardId(wardId) && existing().wardId == wardId;
        allow create: if isValidWardId(wardId) && isValidId(memoryId) &&
          isValidWardAiMemory(incoming()) && incoming().wardId == wardId && wardExists(wardId);
        allow update: if isValidWardId(wardId) && isValidId(memoryId) &&
          isValidWardAiMemory(incoming()) &&
          incoming().id == existing().id &&
          incoming().wardId == wardId &&
          wardExists(wardId);
        allow delete: if isValidWardId(wardId) && isValidId(memoryId) && wardExists(wardId);
      }
    }

    // Admin Allowlist
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid);
      allow create, update: if isAdmin() && isValidId(adminId) && isValidAdminDoc(incoming());
      allow delete: if isAdmin() && isValidId(adminId);
    }

    // User Profiles (PII protected: owner or admin only, no privilege escalation, no salt/hash)
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isVerifiedUser() && (isBootstrappedAdmin() || existing().id == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(userId) && isValidUserProfile(incoming()) && (
        isAdmin() ||
        (request.auth.uid == userId && (!('role' in incoming()) || incoming().role == 'user'))
      );
      allow update: if isVerifiedUser() && isValidId(userId) && isValidUserProfile(incoming()) && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          incoming().id == existing().id &&
          (!('role' in incoming()) || incoming().role == existing().role) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'uid', 'email', 'username', 'name', 'position', 'signature',
            'active', 'must', 'created', 'last', 'avatar', 'ringColor'
          ])
        )
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Legacy Master & Global Inspection Workspace Collections
    match /equipment/{itemId} {
      allow get: if isVerifiedUser() && isValidId(itemId);
      allow list: if isVerifiedUser();
      allow create, update: if isVerifiedUser() && isValidId(itemId) && isValidEquipment(incoming());
      allow delete: if isAdmin() && isValidId(itemId);
    }

    match /drugs/{drugId} {
      allow get: if isVerifiedUser() && isValidId(drugId);
      allow list: if isVerifiedUser();
      allow create, update: if isVerifiedUser() && isValidId(drugId) && isValidDrug(incoming());
      allow delete: if isAdmin() && isValidId(drugId);
    }

    match /inspection_records/{recordId} {
      allow get: if isVerifiedUser() && isValidId(recordId);
      allow list: if isVerifiedUser();
      allow create, update: if isVerifiedUser() && isValidId(recordId) && isValidInspectionRecord(incoming());
      allow delete: if isAdmin() && isValidId(recordId);
    }

    match /settings/{docId} {
      allow get: if isVerifiedUser() && isValidId(docId) && docId in ['config', 'app_state', 'channels'];
      allow list: if false;
      allow create, update: if isVerifiedUser() && isValidId(docId) && isValidSettings(incoming()) && (
        docId in ['app_state', 'channels'] ||
        (docId == 'config' && isAdmin())
      );
      allow delete: if false;
    }

    match /restock_requisitions/{reqId} {
      allow get: if isVerifiedUser() && isValidId(reqId);
      allow list: if isVerifiedUser();
      allow create: if isVerifiedUser() && isValidId(reqId) && isValidRestockRequisition(incoming()) && (
        isAdmin() || !('status' in incoming()) || incoming().status in ['draft', 'pending']
      );
      allow update: if isVerifiedUser() && isValidId(reqId) && isValidRestockRequisition(incoming()) && (
        isAdmin() ||
        (existing().status != 'received' && incoming().status in ['draft', 'pending'] && existing().status in ['draft', 'pending', 'rejected'])
      );
      allow delete: if isAdmin() && isValidId(reqId) && existing().status != 'received';
    }

    // Legacy Channel-Isolated Ward Documents & Subcollections
    match /channels/{channelId} {
      allow get: if isVerifiedUser() && isValidId(channelId);
      allow list: if isVerifiedUser();
      allow create, update: if isVerifiedUser() && isValidId(channelId) && isValidChannelData(incoming());
      allow delete: if isAdmin() && isValidId(channelId);

      match /equipment/{itemId} {
        allow get: if isVerifiedUser() && isValidId(channelId) && isValidId(itemId);
        allow list: if isVerifiedUser();
        allow create, update: if isVerifiedUser() && isValidId(channelId) && isValidId(itemId) && isValidEquipment(incoming()) && matchesChannelScope(incoming(), channelId);
        allow delete: if isAdmin() && isValidId(channelId) && isValidId(itemId);
      }

      match /drugs/{drugId} {
        allow get: if isVerifiedUser() && isValidId(channelId) && isValidId(drugId);
        allow list: if isVerifiedUser();
        allow create, update: if isVerifiedUser() && isValidId(channelId) && isValidId(drugId) && isValidDrug(incoming()) && matchesChannelScope(incoming(), channelId);
        allow delete: if isAdmin() && isValidId(channelId) && isValidId(drugId);
      }

      match /inspection_records/{recordId} {
        allow get: if isVerifiedUser() && isValidId(channelId) && isValidId(recordId);
        allow list: if isVerifiedUser();
        allow create, update: if isVerifiedUser() && isValidId(channelId) && isValidId(recordId) && isValidInspectionRecord(incoming()) && matchesChannelScope(incoming(), channelId);
        allow delete: if isAdmin() && isValidId(channelId) && isValidId(recordId);
      }

      match /restock_requisitions/{reqId} {
        allow get: if isVerifiedUser() && isValidId(channelId) && isValidId(reqId);
        allow list: if isVerifiedUser();
        allow create: if isVerifiedUser() && isValidId(channelId) && isValidId(reqId) && isValidRestockRequisition(incoming()) && matchesChannelScope(incoming(), channelId) && (
          isAdmin() || !('status' in incoming()) || incoming().status in ['draft', 'pending']
        );
        allow update: if isVerifiedUser() && isValidId(channelId) && isValidId(reqId) && isValidRestockRequisition(incoming()) && matchesChannelScope(incoming(), channelId) && (
          isAdmin() ||
          (existing().status != 'received' && incoming().status in ['draft', 'pending'] && existing().status in ['draft', 'pending', 'rejected'])
        );
        allow delete: if isAdmin() && isValidId(channelId) && isValidId(reqId) && existing().status != 'received';
      }
    }

    // Immutable Append-Only Audit Log Collection (includes HA & HL7 FHIR Dispensations)
    match /audit_logs/{logId} {
      allow get: if isVerifiedUser() && isValidId(logId) && (isAdmin() || existing().userId == request.auth.uid);
      allow list: if isVerifiedUser() && (isBootstrappedAdmin() || existing().userId == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(logId) && isValidAuditLog(incoming()) && (
        isAdmin() || incoming().userId == request.auth.uid
      );
      allow update, delete: if false;
    }
  }
}

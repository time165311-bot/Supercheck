rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Catch-all: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Equipment Collection
    match /equipment/{itemId} {
      allow read, write: if true;
    }

    // Drugs Collection
    match /drugs/{drugId} {
      allow read, write: if true;
    }

    // Inspection Records Collection
    match /inspection_records/{recordId} {
      allow read, write: if true;
    }

    // Settings Collection
    match /settings/{docId} {
      allow read, write: if true;
    }
  }
}
